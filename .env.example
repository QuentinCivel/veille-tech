# Copier ce fichier en .env (jamais versionné) et remplir les valeurs.
# Sur Netlify : Site configuration > Environment variables (mêmes noms).

# URL publique du site (liens dans les e-mails d'alerte)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Firebase Admin : compte de service (Paramètres du projet > Comptes de service > Générer une clé privée)
# SECRET. Recopier les champs project_id, client_email et private_key du fichier JSON téléchargé.
NUXT_FIREBASE_PROJECT_ID=mon-projet
NUXT_FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@mon-projet.iam.gserviceaccount.com
# Garder les \n littéraux et les guillemets
NUXT_FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Resend (https://resend.com/api-keys) — SECRET
NUXT_RESEND_API_KEY=
# Expéditeur sur un domaine vérifié dans Resend (ou onboarding@resend.dev pour tester vers sa propre adresse)
NUXT_ALERT_FROM_EMAIL="Veille Tech <alertes@mon-domaine.fr>"

# --- Collecte automatique
# Secret partagé avec la Scheduled Function Netlify (32 caractères minimum).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_CRON_SECRET=
# Optionnel mais recommandé : jeton GitHub "fine-grained" sans aucune permission (lecture publique)
# pour passer de 60 à 5 000 requêtes/heure sur l'API GitHub.
NUXT_GITHUB_TOKEN=
